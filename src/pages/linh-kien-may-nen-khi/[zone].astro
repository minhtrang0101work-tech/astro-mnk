---
import Breadcrumb from '@/components/Breadcrumb';
import CTABanner from '@/components/CTABanner';
import RandomProducts from '@/components/RandomProducts';
import { getLocale, getDictionary } from '@/lib/i18n';
import { ProductRepository } from '@/repositories/product.repository';
import Layout from '@/layouts/Layout.astro';

export async function getStaticPaths() {
  const zones = [
    'kcn-amata', 'kcn-bien-hoa-1', 'kcn-bien-hoa-2', 'kcn-nhon-trach', 'kcn-nhon-trach-1', 'kcn-nhon-trach-2',
    'kcn-vsip', 'kcn-vsip-1', 'kcn-vsip-2', 'kcn-song-than', 'kcn-giang-dien', 'kcn-long-thanh', 'kcn-my-phuoc',
    'kcn-phan-thiet', 'kcn-phu-my', 'kcn-dong-xuyen', 'kcn-trang-bang', 'kcn-phuoc-dong', 'kcn-thuan-dao',
    'bien-hoa', 'nhon-trach', 'trang-bom', 'long-thanh', 'di-an', 'thuan-an', 'thu-dau-mot', 'duc-hoa',
    'quan-12', 'binh-tan', 'dong-nai', 'binh-duong', 'ho-chi-minh', 'long-an', 'binh-thuan', 'ba-ria-vung-tau', 'tay-ninh'
  ];
  return zones.map(zone => ({ params: { zone } }));
}

const { zone, category, slug } = Astro.params;
const props = Astro.props;
const locale = 'vi';


  const zone = Astro.params.zone;
  const locale = "vi";
  const dict = await getDictionary(locale);
  const details = zoneInfoMap[zone] || zoneInfoMap['kcn-amata'];
  
  // Read products from repository for display
  const allProducts = await ProductRepository.getAllProducts();
  // Filter for parts-related categories to make the base array highly relevant
  const partsProducts = allProducts.filter(p => 
    p.category === 'bo-loc-va-tach-khi-nen' || 
    p.category === 'dau-may-va-phu-tung-boi-tron' || 
    p.category === 'he-thong-cac-loai-van-khi-nen' ||
    p.category === 'luc-nen-co-khi-dong-co'
  );

  const breadcrumbItems = [
    { label: locale === 'vi' ? 'Linh kiện máy nén khí' : 'Parts', href: '/linh-kien-may-nen-khi' },
    { label: details.nameVi }
  ];

  const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": locale === 'vi' 
          ? `Thời gian giao phụ tùng máy nén khí đến ${details.locationVi} là bao lâu?` 
          : `How long does it take to deliver compressor parts to ${details.locationVi}?`,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": locale === 'vi' 
            ? `Khải Nguyên hỗ trợ giao hàng hỏa tốc trong vòng 2 giờ tận nơi nhà xưởng tại ${details.nameVi} đối với các phụ tùng tiêu hao định kỳ có sẵn như lọc tách dầu, lọc dầu, lọc gió và dầu làm mát máy nén khí.` 
            : `Khai Nguyen supports express delivery within 2 hours to factories in ${details.nameVi} for standard parts in stock, including oil separators, oil filters, air filters, and lubricants.`
        }
      },
      {
        "@type": "Question",
        "name": locale === 'vi' 
          ? `Phụ tùng mua tại Khải Nguyên có được bảo hành không?` 
          : `Do compressor parts purchased from Khai Nguyen have a warranty?`,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": locale === 'vi' 
            ? `Tất cả linh kiện và phụ tùng phân phối bởi Khải Nguyên đều cam kết chính hãng 100% và bảo hành đầy đủ từ 3 đến 12 tháng (tương đương 2.000 đến 4.000 giờ chạy máy). Lỗi 1 đổi 1 ngay lập tức nếu do nhà sản xuất.` 
            : `All components and parts distributed by Khai Nguyen are guaranteed 100% genuine with a 3 to 12-month warranty (equivalent to 2,000 to 4,000 running hours). Immediate 1-to-1 replacement for manufacturing defects.`
        }
      }
    ]
  };

  
---

<Layout locale={locale}>
  <div>
      <script type="application/ld+json" is:inline
        set:html={JSON.stringify(faqSchema)}
      />
      <Breadcrumb title={locale === 'vi' ? `Cung Cấp Linh Kiện Tại ${details.locationVi}` : `Parts Supply in ${details.locationVi}`} items={breadcrumbItems} />

      <section className="section-padding">
        <div className="container" style={{ maxWidth: '900px', margin: '0 auto' }}>
          <article className="service-detail-content" style={{ fontSize: '15.5px', lineHeight: '1.8', color: 'var(--text-color)' }}>
            
            {/* AEO Freshness Signals */}
            <div style={{ fontSize: '13.5px', color: 'var(--text-light)', marginBottom: '20px', display: 'flex', alignItems: 'center', gap: '6px' }}>
              <i className="far fa-calendar-alt"></i>
              <span>{locale === 'vi' ? 'Cập nhật lần cuối: 2026-08-05' : 'Last updated: 2026-08-05'}</span>
              <span style={{ margin: '0 8px', color: '#ccc' }}>|</span>
              <i className="far fa-user"></i>
              <span>{locale === 'vi' ? 'Đơn vị phân phối: Máy nén khí Khải Nguyên' : 'Distributor: Khai Nguyen Air Compressor'}</span>
            </div>

            {/* Introductory Box */}
            <div style={{ 
              fontWeight: 600, 
              fontSize: '17px', 
              color: 'var(--text-dark)', 
              marginBottom: '25px', 
              padding: '18px 24px', 
              backgroundColor: 'var(--bg-light)', 
              borderLeft: '4px solid var(--primary-color)',
              borderRadius: '0 var(--radius-sm) var(--radius-sm) 0',
              lineHeight: '1.6'
            }}>
              {details.introVi}
            </div>

            <p>
              {locale === 'vi' 
                ? `Nhằm hỗ trợ tốt nhất cho hoạt động vận hành liên tục của các nhà máy tại ${details.nameVi}, Khải Nguyên cung cấp kho phụ tùng đa dạng, đầy đủ kích thước và thông số kỹ thuật tương thích hoàn toàn với hệ thống máy nén khí trục vít của bạn.`
                : `To best support the continuous operation of factories in ${details.nameVi}, Khai Nguyen offers a diverse inventory of spare parts, fully compatible with your air compressor systems.`}
            </p>

            {/* Grid Gallery displaying real B2B photos of our works */}
            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(180px, 1fr))', gap: '15px', margin: '35px 0' }}>
