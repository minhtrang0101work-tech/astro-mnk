---
import Layout from '@/layouts/Layout.astro';
import { ProductRepository } from '@/repositories/product.repository';
import { ProductService } from '@/services/product.service';
import Breadcrumb from '@/components/Breadcrumb';
import ProductGallery from '@/features/products/ProductGallery';
import ProductDescription from '@/features/products/ProductDescription';
import ProductCard from '@/features/products/ProductCard';
import CTABanner from '@/components/CTABanner';
import { getDictionary } from '@/lib/i18n';

export async function getStaticPaths() {
  const products = await ProductRepository.getAllProducts('vi');
  return products.map(product => ({
    params: { category: product.category, slug: product.slug },
    props: { product }
  }));
}

const { category, slug } = Astro.params;
const { product } = Astro.props;

const locale = 'vi';
const dict = await getDictionary(locale);

let relatedProducts = await ProductService.getRelatedProducts(product.id, product.category, 3);
if (relatedProducts.length === 0) {
  const featured = await ProductService.getFeaturedProducts(4);
  relatedProducts = featured.filter(p => p.id !== product.id).slice(0, 3);
}

const baseUrl = 'https://maynenkhikhainguyen.com';
const absoluteImageUrl = product.image.startsWith('http') ? product.image : `${baseUrl}${product.image}`;
const cleanDescription = product.description ? product.description.replace(/<[^>]*>?/gm, '').trim() : '';
const finalDescription = cleanDescription || `Chuyên cung cấp ${product.title} chính hãng, chất lượng cao, giá cạnh tranh nhất tại Khải Nguyên.`;

const productSchema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": product.title,
  "image": [absoluteImageUrl],
  "description": finalDescription,
  "sku": product.id,
  "mpn": (product.specs && product.specs['Mã MPN'] !== 'Chưa cập nhật') ? product.specs['Mã MPN'] : undefined,
  "brand": {
    "@type": "Brand",
    "name": (product.specs && product.specs['Thương hiệu']) || "Khải Nguyên"
  },
  "offers": {
    "@type": "Offer",
    "url": `${baseUrl}/san-pham/${category}/${product.slug}`,
    "priceCurrency": "VND",
    "price": (product.price && product.price !== 'Liên hệ báo giá') ? parseInt(product.price.replace(/[^0-9]/g, '') || "3000000", 10) : 3000000,
    "priceValidUntil": "2026-12-31",
    "availability": "https://schema.org/InStock",
    "itemCondition": "https://schema.org/NewCondition"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `Sản phẩm ${product.title} có sẵn hàng tại kho Khải Nguyên không?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Có. Khải Nguyên luôn sẵn kho số lượng lớn tại Đồng Nai, hỗ trợ giao hàng hỏa tốc trong 2 giờ tại các KCN Biên Hòa, Amata, Nhơn Trạch, Long Thành, VSIP, Sóng Thần.`
      }
    },
    {
      "@type": "Question",
      "name": `Chính sách bảo hành cho ${product.title} như thế nào?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Sản phẩm được bảo hành chính hãng từ 6 đến 24 tháng theo tiêu chuẩn nhà sản xuất, 1 đổi 1 nếu phát hiện lỗi kỹ thuật.`
      }
    },
    {
      "@type": "Question",
      "name": `Khải Nguyên có hỗ trợ khảo sát và lắp đặt tận nơi không?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Đội ngũ kỹ sư dày dặn kinh nghiệm của chúng tôi sẵn sàng đến tận nhà xưởng để khảo sát, tư vấn giải pháp và lắp đặt hoàn chỉnh.`
      }
    }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": dict.common.home || "Trang chủ",
      "item": baseUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": dict.common.products || "Sản phẩm",
      "item": `${baseUrl}/san-pham`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": product.categoryName,
      "item": `${baseUrl}/san-pham/${product.category}`
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": product.title,
      "item": `${baseUrl}/san-pham/${category}/${product.slug}`
    }
  ]
};

const breadcrumbItems = [
  { label: dict.common.products, href: '/san-pham' },
  { label: product.categoryName, href: `/san-pham/${product.category}` },
  { label: product.title }
];
---

<Layout
  title={`${product.title} | Phụ Tùng Máy Nén Khí Khải Nguyên`}
  description={finalDescription.slice(0, 160)}
  canonical={`${baseUrl}/san-pham/${category}/${product.slug}`}
  image={absoluteImageUrl}
  schema={[productSchema, faqSchema, breadcrumbSchema]}
  locale={locale}
>
  <div class="product-detail-page-container">
    <Breadcrumb title={product.title} items={breadcrumbItems} locale={locale} />

    <section class="section-padding">
      <div class="container">
        <div class="detail-grid">
          <ProductGallery initialImage={product.image} alt={product.title} client:load />

          <div class="detail-info">
            <span class="product-cat">
              {product.categoryName}
            </span>
            <h2 style="font-size: 26px; color: var(--text-dark); margin-bottom: 12px; font-weight: 700;">{product.title}</h2>
            
            <p style="color: var(--text-color); font-size: 15px; line-height: 1.6; margin-bottom: 20px;">
              Sản phẩm {product.title} là linh kiện phụ tùng thay thế chất lượng OEM, được Khải Nguyên phân phối và lắp đặt tận nơi tại các nhà máy ở Đồng Nai, Bình Dương, và TP.HCM.
            </p>

            <div class="detail-price-box">
              <div>
                <span class="price-label">Giá niêm yết:</span>
                <span class="price-value">{product.price || 'Liên hệ báo giá'}</span>
              </div>
            </div>

            <div class="detail-actions">
              <a href={`/lien-he?product=${encodeURIComponent(product.title)}`} class="btn btn-primary" style="padding: 15px 35px;" data-astro-prefetch="hover">
                <i class="fab fa-telegram-plane" style="margin-right: 8px;"></i> {dict.productDetail.quoteBtn}
              </a>
              <a href="tel:0909513637" class="btn btn-outline-dark" style="padding: 15px 35px;">
                <i class="fas fa-phone-alt" style="margin-right: 8px;"></i> 0909 513 637
              </a>
            </div>

            <ul class="detail-bullets">
              <li><i class="fas fa-certificate" style="color: #22c55e; font-size: 15px;"></i> Cam kết chất lượng chính hãng 100%</li>
              <li><i class="fas fa-shield-alt" style="color: #22c55e; font-size: 15px;"></i> Bảo hành chính hãng uy tín từ 6 - 24 tháng</li>
              <li><i class="fas fa-user-shield" style="color: #22c55e; font-size: 15px;"></i> Đội ngũ kỹ sư hỗ trợ khảo sát tận nơi miễn phí</li>
            </ul>
          </div>
        </div>

        <div class="detail-grid detail-specs-section">
          <div>
            <ProductDescription client:load description={product.description} specs={product.specs} locale={locale} />
          </div>

          <div class="detail-sidebar">
            <h3 class="sidebar-title">{dict.productDetail.whyTitle}</h3>
            <ul class="sidebar-reason-list">
              <li><i class="fas fa-check-circle"></i> Linh kiện đúng chuẩn kích thước & áp suất kỹ thuật</li>
              <li><i class="fas fa-check-circle"></i> Đội ngũ kỹ sư hơn 15 năm kinh nghiệm về khí nén</li>
              <li><i class="fas fa-check-circle"></i> Hàng sẵn kho Biên Hòa, giao nhanh trong 2 giờ</li>
              <li><i class="fas fa-check-circle"></i> Giá cả cạnh tranh tối ưu chi phí vận hành</li>
            </ul>
          </div>
        </div>

        <!-- Product FAQ Section -->
        <div class="product-faq-section" style="margin-top: 60px; border-top: 1px solid var(--border-color); padding-top: 40px;">
          <h3 class="specs-title" style="margin-bottom: 25px;">Câu hỏi thường gặp về sản phẩm</h3>
          
          <div class="product-faq-list" style="display: flex; flex-direction: column; gap: 16px;">
            <div class="product-faq-item" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 22px 24px;">
              <h4 style="font-size: 15.5px; font-weight: 700; color: var(--text-dark); margin-bottom: 8px;">
                Q: Linh kiện {product.title} có tương thích với dòng máy nén khí của tôi không?
              </h4>
              <p style="font-size: 14.5px; line-height: 1.6; color: var(--text-color); margin: 0;">
                A: Các sản phẩm linh kiện do Khải Nguyên cung cấp (bao gồm cả {product.title}) được thiết kế tương thích chuẩn cho các dòng máy nén khí trục vít Atlas Copco, Kobelco, Hitachi, Ingersoll Rand... Vui lòng liên hệ Hotline 0909 513 637 và gửi mã model máy để kỹ sư của chúng tôi xác minh sự phù hợp 100%.
              </p>
            </div>

            <div class="product-faq-item" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 22px 24px;">
              <h4 style="font-size: 15.5px; font-weight: 700; color: var(--text-dark); margin-bottom: 8px;">
                Q: Linh kiện phụ tùng máy nén khí được bảo hành bao lâu?
              </h4>
              <p style="font-size: 14.5px; line-height: 1.6; color: var(--text-color); margin: 0;">
                A: Các sản phẩm lọc dầu, lọc gió được bảo hành 3 tháng (tương đương 2.000 giờ chạy máy). Lọc tách dầu khí nén được bảo hành 6 tháng (tương đương 4.000 giờ chạy máy). Các két làm mát giải nhiệt hoặc phụ tùng cơ khí nặng khác bảo hành từ 12 đến 24 tháng.
              </p>
            </div>

            <div class="product-faq-item" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 22px 24px;">
              <h4 style="font-size: 15.5px; font-weight: 700; color: var(--text-dark); margin-bottom: 8px;">
                Q: Khải Nguyên có hỗ trợ thay thế phụ tùng tận nơi không?
              </h4>
              <p style="font-size: 14.5px; line-height: 1.6; color: var(--text-color); margin: 0;">
                A: Có, chúng tôi có đội ngũ kỹ thuật giao hàng và hỗ trợ thay thế phụ tùng, lọc, dầu máy nén khí trực tiếp tại nhà xưởng của bạn ở khu vực Đồng Nai, Bình Dương, Long An, HCMC để đảm bảo quy trình bảo dưỡng chuẩn kỹ thuật.
              </p>
            </div>
          </div>
        </div>

        {relatedProducts.length > 0 && (
          <div style="margin-top: 60px; border-top: 1px solid var(--border-color); padding-top: 40px;">
            <h3 class="specs-title">{dict.productDetail.relatedTitle}</h3>
            <div class="products-grid">
              {relatedProducts.map((related) => (
                <ProductCard product={related} />
              ))}
            </div>
          </div>
        )}
      </div>
    </section>

    <CTABanner client:visible locale={locale} />
  </div>
</Layout>
