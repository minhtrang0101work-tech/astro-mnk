---
import { PageService } from '@/services/page.service';
import { NewsService } from '@/services/news.service';
import Breadcrumb from '@/components/Breadcrumb';
import NewsCard from '@/features/news/NewsCard';
import CTABanner from '@/components/CTABanner';
import NewsletterForm from '@/components/NewsletterForm';
import { getLocale, getDictionary } from '@/lib/i18n';
import Layout from '@/layouts/Layout.astro';
const { zone, category, slug } = Astro.params;
const props = Astro.props;
const locale = 'vi';


  const locale = "vi";
  const dict = await getDictionary(locale);

  // Safe await searchParams
  const searchParams = props.searchParams ? await props.searchParams : {};
  const activeCategory = searchParams?.category || '';

  // Tối ưu hóa: Nạp song song danh sách bài viết theo bộ lọc và toàn bộ bài viết để tính số lượng
  const [filteredResult, allNewsResult] = await Promise.all([
    NewsService.getNews({ category: activeCategory || undefined }),
    NewsService.getNews()
  ]);
  const articles = filteredResult.news;
  const allNews = allNewsResult.news;
  const totalCount = allNews.length;
  const tinTucCount = allNews.filter(n => n.category === 'tin-tuc' || n.category === 'cong-nghe').length;
  const tuVanCount = allNews.filter(n => n.category === 'tu-van' || n.category === 'ky-thuat' || n.category === 'kien-thuc').length;
  const baoTriCount = allNews.filter(n => n.category === 'bao-tri').length;
  const duAnCount = allNews.filter(n => n.category === 'du-an').length;

  const getCategoryName = (cat: string) => {
    const isEn = locale === 'en';
    const isZh = locale === 'zh';
    switch (cat) {
      case 'tin-tuc':
        return isEn ? 'Industry News' : isZh ? '行业新闻' : 'Tin tức ngành';
      case 'tu-van':
        return isEn ? 'Technical Advice' : isZh ? '技术咨询' : 'Tư vấn kỹ thuật';
      case 'bao-tri':
        return isEn ? 'Maintenance' : isZh ? '设备保养' : 'Bảo trì bảo dưỡng';
      case 'du-an':
        return isEn ? 'Installation Projects' : isZh ? '安装项目' : 'Dự án lắp đặt';
      default:
        return isEn ? 'All News' : isZh ? '所有资讯' : 'Tất cả tin tức';
    }
  };

  const breadcrumbItems = [{ label: dict.common.news }];
  let pageTitle = dict.news.title;

  if (activeCategory) {
    pageTitle = `${locale === 'vi' ? 'Danh mục' : locale === 'zh' ? '分类' : 'Category'}: ${getCategoryName(activeCategory)}`;
    breadcrumbItems.push({ label: getCategoryName(activeCategory) });
  }

  // Categories helper to highlight active link
  const getStyle = (cat?: string) => {
    return activeCategory === cat ? { color: 'var(--accent-color)', fontWeight: 700 } : {};
  };

  
---

<Layout locale={locale}>
  <div>
      <Breadcrumb title={pageTitle} items={breadcrumbItems} />

      <section className="section-padding">
        <div className="container blog-layout">
          {/* Main news grid */}
          <div className="blog-main">
            <div style={{ borderBottom: '2px solid var(--border-color)', paddingBottom: '12px', marginBottom: '30px' }}>
              <h2 style={{ fontSize: '22px', fontWeight: 700, color: 'var(--text-dark)', margin: 0 }}>
                {activeCategory 
                  ? `${locale === 'vi' ? 'BÀI VIẾT THUỘC' : locale === 'zh' ? '文章分类' : 'ARTICLES IN'} "${getCategoryName(activeCategory).toUpperCase()}"` 
                  : dict.news.allArticles}
              </h2>
            </div>

            {articles.length === 0 ? (
              <div style={{ padding: '60px 0', textAlign: 'center', color: 'var(--text-light)' }}>
                <i className="fas fa-folder-open" style={{ fontSize: '48px', marginBottom: '15px', color: 'var(--accent-color)' }}></i>
                <h3>{dict.news.noArticles}</h3>
                <p>{dict.news.noArticlesDesc}</p>
              </div>
            ) : (
              <div className="blog-grid">
                {articles.map((article) => (
                  <NewsCard key={article.id} news={article} locale={locale} />
                ))}
              </div>
            )}

            {/* Pagination */}
            {articles.length > 0 && (
              <div className="pagination" style={{ marginTop: '40px' }}>
                <a href="#" className="pagination-item active" data-astro-prefetch="hover">1</a>
                <a href="#" className="pagination-item" data-astro-prefetch="hover">2</a>
                <a href="#" className="pagination-item" data-astro-prefetch="hover">3</a>
              </div>
            )}
          </div>

          {/* Sidebar */}
          <aside className="blog-sidebar">
            {/* Widget 1: Newsletter */}
            <div className="sidebar-widget">
              <h3>{dict.news.newsletterTitle}</h3>
              <div className="widget-newsletter" style={{ marginTop: '15px' }}>
                <p style={{ color: 'var(--text-light)', fontSize: '13.5px', marginBottom: '15px', lineHeight: '1.5' }}>
                  {dict.news.newsletterDesc}
                </p>
                <NewsletterForm />
              </div>
            </div>

            {/* Widget 2: Categories */}
            <div className="sidebar-widget">
              <h3>{locale === 'vi' ? 'DANH MỤC TIN TỨC' : locale === 'zh' ? '新闻分类' : 'NEWS CATEGORIES'}</h3>
              <ul className="widget-categories-list">
                <li>
                  <a href="/tin-tuc" style={getStyle('')} data-astro-prefetch="hover">{locale === 'vi' ? 'Tất cả tin tức' : locale === 'zh' ? '所有资讯' : 'All News'}</a>
                  <span className="count">{totalCount}</span>
                </li>
                <li>
                  <a href="/tin-tuc/tin-tuc" style={getStyle('tin-tuc')} data-astro-prefetch="hover">{getCategoryName('tin-tuc')}</a>
                  <span className="count">{tinTucCount}</span>
                </li>
                <li>
                  <a href="/tin-tuc/tu-van" style={getStyle('tu-van')} data-astro-prefetch="hover">{getCategoryName('tu-van')}</a>
                  <span className="count">{tuVanCount}</span>
                </li>
                <li>
                  <a href="/tin-tuc/bao-tri" style={getStyle('bao-tri')} data-astro-prefetch="hover">{getCategoryName('bao-tri')}</a>
                  <span className="count">{baoTriCount}</span>
                </li>
                <li>
                  <a href="/tin-tuc/du-an" style={getStyle('du-an')} data-astro-prefetch="hover">{getCategoryName('du-an')}</a>
                  <span className="count">{duAnCount}</span>
                </li>
              </ul>
            </div>
          </aside>
        </div>
      </section>

      <CTABanner locale={locale} />
    </div>
</Layout>
