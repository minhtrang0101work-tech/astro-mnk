---
import Layout from '@/layouts/Layout.astro';
import { NewsRepository } from '@/repositories/news.repository';
import { NewsService } from '@/services/news.service';
import Breadcrumb from '@/components/Breadcrumb';
import NewsCard, { categoryMap } from '@/features/news/NewsCard';
import NewsletterForm from '@/components/NewsletterForm';
import CTABanner from '@/components/CTABanner';
import { getDictionary } from '@/lib/i18n';

export async function getStaticPaths() {
  const newsList = await NewsRepository.getAllNews('en');
  return newsList.map(news => ({
    params: { category: news.category, slug: news.slug },
    props: { news }
  }));
}

const { category, slug } = Astro.params;
const { news: article } = Astro.props;

const locale = 'en';
const dict = await getDictionary(locale);

const relatedArticles = await NewsService.getRelatedNews(article.id, article.category, 3);
const catObj = categoryMap[article.category] || { vi: article.category, zh: article.category, en: article.category };
const categoryName = catObj['en'];

const breadcrumbItems = [
  { label: dict.common.news, href: '/en/tin-tuc' },
  { label: categoryName, href: `/en/tin-tuc/${article.category}` },
  { label: article.title }
];

const baseUrl = 'https://maynenkhikhainguyen.com';
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": article.title,
  "image": [article.image.startsWith('http') ? article.image : `${baseUrl}${article.image}`],
  "datePublished": article.rawDate || article.date,
  "dateModified": article.rawDate || article.date,
  "author": [{
    "@type": "Person",
    "name": "Khai Nguyen Senior Engineer",
    "url": baseUrl
  }]
};
---

<Layout
  title={`${article.title} | Khai Nguyen Compressor News & Insights`}
  description={article.description}
  canonical={`${baseUrl}/tin-tuc/${category}/${article.slug}`}
  schema={articleSchema}
  locale="en"
>
  <div>
    <Breadcrumb title={article.title} items={breadcrumbItems} locale="en" />

    <section class="section-padding">
      <div class="container blog-layout">
        <article class="blog-main-content" style="display: flex; flex-direction: column; gap: 20px;">
          <div class="article-header">
            <span class="news-category" style="font-weight: 700; color: var(--accent-color);">{categoryName}</span>
            <h1 style="font-size: 28px; color: var(--text-dark); margin: 15px 0; font-weight: 800;">{article.title}</h1>
            <div style="font-size: 13px; color: var(--text-light); margin-bottom: 20px;">
              <i class="far fa-calendar-alt" style="margin-right: 5px;"></i> {article.date} | 
              <i class="far fa-user" style="margin-left: 10px; margin-right: 5px;"></i> Khai Nguyen Senior Engineer
            </div>
          </div>

          <div class="article-featured-img">
            <img src={article.image} alt={article.title} style="width: 100%; border-radius: 4px;" loading="lazy" />
          </div>

          <div class="article-body" style="line-height: 1.8; font-size: 16px; color: var(--text-color);">
            <p style="font-weight: 600; font-size: 17px; margin-bottom: 20px;">{article.description}</p>
            {article.content ? (
              <div set:html={article.content} />
            ) : (
              <p>Khải Nguyên cung cấp dịch vụ bảo trì, sửa chữa và linh kiện máy nén khí chất lượng cao tại Đồng Nai, Bình Dương và TP.HCM.</p>
            )}
          </div>

          {relatedArticles.length > 0 && (
            <div style="margin-top: 50px; border-top: 1px solid var(--border-color); padding-top: 30px;">
              <h3 style="font-size: 20px; font-weight: 700; margin-bottom: 20px;">Related Articles</h3>
              <div class="related-news-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
                {relatedArticles.map((rel) => (
                  <NewsCard news={rel} locale="en" />
                ))}
              </div>
            </div>
          )}
        </article>

        <aside class="blog-sidebar">
          <div class="sidebar-widget">
            <h3>Newsletter Subscription</h3>
            <div class="widget-newsletter" style="margin-top: 15px;">
              <NewsletterForm dict={dict.footer} client:visible />
            </div>
          </div>
        </aside>
      </div>
    </section>

    <CTABanner client:visible locale="en" />
  </div>
</Layout>
