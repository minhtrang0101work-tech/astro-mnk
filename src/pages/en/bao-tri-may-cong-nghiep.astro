---
import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb';
import CTABanner from '@/components/CTABanner';

const locale = 'en';
const title = 'Industrial Machinery & Air Compressor Preventative Maintenance';
const breadcrumbItems = [{ label: title }];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'name': 'Khai Nguyen Industrial Equipment Preventative Maintenance',
  'provider': {
    '@type': 'LocalBusiness',
    'name': 'Khai Nguyen Air Compressor'
  },
  'areaServed': ['Dong Nai', 'Binh Duong', 'Ho Chi Minh City'],
  'serviceType': 'Industrial Equipment Preventative Maintenance'
};
---

<Layout locale="en" title={title} description="Scheduled 2,000h - 4,000h preventative maintenance contracts for screw air compressors and industrial equipment in Southern Vietnam.">
  <div>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
    <Breadcrumb title={title} items={breadcrumbItems} locale="en" />

    <section class="section-padding">
      <div class="container" style="max-width: 960px; margin: 0 auto;">
        <article class="service-detail-content" style="font-size: 16px; line-height: 1.8; color: var(--text-color);">
          
          <div style="font-weight: 600; font-size: 17.5px; color: var(--text-dark); margin-bottom: 30px; padding: 20px 26px; background-color: #f0f7ff; border-left: 5px solid var(--primary-color); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; line-height: 1.65;">
            <strong>Khai Nguyen Preventative Maintenance Services</strong> offers turnkey 2,000h, 4,000h, and 8,000h scheduled service contracts for 
            <strong>industrial screw air compressors and auxiliary factory machinery</strong>, helping enterprises reduce unexpected breakdowns by up to 40% and optimize power efficiency.
          </div>

          <h2 style="font-size: 22px; color: var(--primary-color); margin-top: 35px; margin-bottom: 16px; font-weight: 700;">
            1. Standard Maintenance Checklist (12 Points)
          </h2>
          <ul style="padding-left: 20px; margin-bottom: 20px; display: flex; flex-direction: column; gap: 8px;">
            <li>Replacement of genuine synthetic compressor oil, oil filter, air intake filter, and air-oil separator.</li>
            <li>Cooler cleaning and ultrasonic de-scaling of heat exchangers.</li>
            <li>Greasing and vibration analysis of main electric motor bearings.</li>
            <li>Inspection and recalibration of intake modulation valves and solenoid coils.</li>
            <li>Safety valve pop-off testing and condensate auto-drain service.</li>
          </ul>

          <h2 style="font-size: 22px; color: var(--primary-color); margin-top: 35px; margin-bottom: 15px;">
            2. Schedule a Free Plant Inspection
          </h2>
          <div style="background-color: var(--bg-white); border: 2px solid var(--accent-color); border-radius: 8px; padding: 25px; margin-bottom: 30px;">
            <p style="margin-bottom: 8px;"><strong>Consultation Hotline:</strong> <a href="tel:0909513637" style="color: var(--accent-color); font-weight: 700;">0909 513 637</a></p>
            <p style="margin-bottom: 0;"><strong>Benefit:</strong> Free comprehensive on-site survey and air audit report for factory managers.</p>
          </div>
        </article>
      </div>
    </section>

    <CTABanner client:visible locale="en" />
  </div>
</Layout>
