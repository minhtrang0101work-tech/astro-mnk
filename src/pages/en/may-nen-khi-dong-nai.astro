---
import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb';
import CTABanner from '@/components/CTABanner';

const locale = 'en';
const title = 'Dong Nai Air Compressor Store - Sales, Rental & 24/7 Repair';
const breadcrumbItems = [{ label: title }];

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  'name': 'Khai Nguyen Air Compressor Dong Nai',
  'image': 'https://maynenkhikhainguyen.com/images/khobar-dongnai/kho-phu-tung-fusheng-dong-nai.jpg',
  '@id': 'https://maynenkhikhainguyen.com/en/may-nen-khi-dong-nai',
  'url': 'https://maynenkhikhainguyen.com/en/may-nen-khi-dong-nai',
  'telephone': '0909.513.637',
  'priceRange': '$$$',
  'address': {
    '@type': 'PostalAddress',
    'streetAddress': '762a Hamlet 25, Long Binh Ward',
    'addressLocality': 'Bien Hoa',
    'addressRegion': 'Dong Nai',
    'postalCode': '810000',
    'addressCountry': 'VN'
  },
  'geo': {
    '@type': 'GeoCoordinates',
    'latitude': 10.926839,
    'longitude': 106.883713
  },
  'hasMap': 'https://maps.app.goo.gl/zewZCeEwq8KnPSMk6',
  'openingHoursSpecification': {
    '@type': 'OpeningHoursSpecification',
    'dayOfWeek': ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    'opens': '07:30',
    'closes': '19:00'
  }
};
---

<Layout locale="en" title={title} description="Authorized air compressor sales, rental, and 24/7 emergency repair center in Bien Hoa, Dong Nai. Genuine spare parts in stock with 2-hour express delivery.">
  <div>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(localBusinessSchema)} />
    <Breadcrumb title={title} items={breadcrumbItems} locale="en" />

    <section class="section-padding">
      <div class="container" style="max-width: 960px; margin: 0 auto;">
        <article class="service-detail-content" style="font-size: 16px; line-height: 1.8; color: var(--text-color);">
          
          <div style="font-size: 13.5px; color: var(--text-light); margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
            <span>Last Updated: 2026-08-14</span>
            <span style="margin: 0 8px; color: #ccc;">|</span>
            <span>Central Warehouse & Service Hub: Bien Hoa, Dong Nai</span>
          </div>

          <div style="font-weight: 600; font-size: 17.5px; color: var(--text-dark); margin-bottom: 30px; padding: 20px 26px; background-color: #f0f7ff; border-left: 5px solid var(--primary-color); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; line-height: 1.65;">
            <strong>Khai Nguyen Air Compressor Dong Nai</strong> is a premier sales and engineering support center specializing in 
            <strong>industrial screw air compressors</strong>, <strong>genuine OEM replacement parts</strong>, 
            temporary compressor rental, and <strong>24/7 on-site repair services across Dong Nai</strong>. Our central warehouse in Bien Hoa guarantees 2-hour express parts delivery to Amata, Bien Hoa 1-2, Nhon Trach, Long Thanh, and Trang Bom Industrial Parks.
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 35px;">
            <div style="background-color: var(--bg-light); padding: 18px; border-radius: 8px; border: 1px solid #e2e8f0; text-align: center;">
              <div style="font-size: 28px; font-weight: 800; color: var(--primary-color);">2-Hour Express</div>
              <div style="font-size: 14px; color: var(--text-light);">Direct delivery to factory workshops</div>
            </div>
            <div style="background-color: var(--bg-light); padding: 18px; border-radius: 8px; border: 1px solid #e2e8f0; text-align: center;">
              <div style="font-size: 28px; font-weight: 800; color: var(--primary-color);">100% Genuine</div>
              <div style="font-size: 14px; color: var(--text-light);">OEM parts for Fusheng, Kobelco, Hitachi</div>
            </div>
            <div style="background-color: var(--bg-light); padding: 18px; border-radius: 8px; border: 1px solid #e2e8f0; text-align: center;">
              <div style="font-size: 28px; font-weight: 800; color: var(--primary-color);">24/7 Emergency</div>
              <div style="font-size: 14px; color: var(--text-light);">Rapid on-site troubleshooting</div>
            </div>
          </div>

          <h2 style="font-size: 22px; color: var(--primary-color); font-weight: 700; margin-top: 35px; margin-bottom: 15px;">
            1. Comprehensive Air Compressor Solutions in Dong Nai
          </h2>
          <p>
            With over 15 years of field experience in Southern Vietnam's industrial corridors, Khai Nguyen provides turnkey solutions including:
          </p>
          <ul style="padding-left: 20px; margin-bottom: 20px; display: flex; flex-direction: column; gap: 8px;">
            <li><strong>Sales & Distribution:</strong> Brand new and inspected second-hand screw compressors (10HP - 200HP) from Kobelco, Hitachi, Atlas Copco, and Fusheng.</li>
            <li><strong>Preventative Maintenance:</strong> Standard 2,000h - 4,000h service packages replacing oil filters, air filters, and air-oil separators.</li>
            <li><strong>Major Air-End Overhaul:</strong> Precision screw rotor realignment, bearing replacement, and dynamic balancing.</li>
            <li><strong>Industrial Compressor Rental:</strong> Backup mobile compressors ready for deployment to prevent factory production downtime.</li>
          </ul>

          <h2 style="font-size: 22px; color: var(--primary-color); font-weight: 700; margin-top: 35px; margin-bottom: 15px;">
            2. Contact Bien Hoa Technical Center
          </h2>
          <div style="background-color: var(--bg-white); border: 2px solid var(--accent-color); border-radius: 8px; padding: 25px; margin-bottom: 30px;">
            <p style="margin-bottom: 8px;"><strong>Address:</strong> 762a Hamlet 25, KP 5, Long Binh Ward, Bien Hoa City, Dong Nai Province</p>
            <p style="margin-bottom: 8px;"><strong>24/7 Hotline / Zalo:</strong> <a href="tel:0909513637" style="color: var(--accent-color); font-weight: 700;">0909 513 637</a></p>
            <p style="margin-bottom: 0;"><strong>Working Hours:</strong> Monday - Saturday (07:30 - 19:00) | Emergency On-Call 24/7</p>
          </div>
        </article>
      </div>
    </section>

    <CTABanner client:visible locale="en" />
  </div>
</Layout>
