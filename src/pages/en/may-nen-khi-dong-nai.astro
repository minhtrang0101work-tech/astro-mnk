---
import Layout from '@/layouts/Layout.astro';


import Breadcrumb from '@/components/Breadcrumb';
import CTABanner from '@/components/CTABanner';





const { zone } = Astro.params;
const locale = 'en';

  const title = 'Cửa Hàng Máy Nén Khí Tại Đồng Nai - Bán, Cho Thuê & Sửa Chữa';
  const breadcrumbItems = [{ label: title }];

  const localBusinessSchema = {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    'name': 'Máy Nén Khí Khải Nguyên Đồng Nai',
    'image': 'https://maynenkhikhainguyen.com/images/khobar-dongnai/kho-phu-tung-fusheng-dong-nai.jpg',
    '@id': 'https://maynenkhikhainguyen.com/may-nen-khi-dong-nai',
    'url': 'https://maynenkhikhainguyen.com/may-nen-khi-dong-nai',
    'telephone': '0909.513.637',
    'priceRange': '$$$',
    'address': {
      '@type': 'PostalAddress',
      'streetAddress': '762a Tổ 25, KP 5, Phường Long Bình',
      'addressLocality': 'Biên Hòa',
      'addressRegion': 'Đồng Nai',
      'postalCode': '810000',
      'addressCountry': 'VN'
    },
    'geo': {
      '@type': 'GeoCoordinates',
      'latitude': 10.926839,
      'longitude': 106.883713
    },
    'hasMap': 'https://maps.app.goo.gl/zewZCeEwq8KnPSMk6',
    'openingHoursSpecification': {
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': [
        'Monday',
        'Tuesday',
        'Wednesday',
        'Thursday',
        'Friday',
        'Saturday',
        'Sunday'
      ],
      'opens': '07:30',
      'closes': '19:00'
    },
    'sameAs': [
      'https://maps.app.goo.gl/zewZCeEwq8KnPSMk6',
      'https://maynenkhikhainguyen.com'
    ]
  };

  
---

<Layout locale="en">
  <div>
      <script type="application/ld+json" is:inline
        set:html={JSON.stringify(localBusinessSchema)}
      />
      
      <Breadcrumb title={title} items={breadcrumbItems} />

      <section class="section-padding">
        <div class="container" style="max-width: 960px; margin: 0 auto;">
          <article class="service-detail-content" style="font-size: 16px; line-height: 1.8; color: var(--text-color);">
            
            {/* Last Updated */}
            <div style="font-size: 13.5px; color: var(--text-light); margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
              <span>Cập nhật mới nhất: 2026-08-14</span>
              <span style="margin: 0 8px; color: #ccc;">|</span>
              <span>Cửa hàng & Kho hàng chính: TP. Biên Hòa, Tỉnh Đồng Nai</span>
            </div>

            {/* Answer Box / Hero Intro */}
            <div style="font-weight: 600; font-size: 17.5px; color: var(--text-dark); margin-bottom: 30px; padding: 20px 26px; background-color: #f0f7ff; border-left: 5px solid var(--primary-color); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; line-height: 1.65;">
              <strong>Máy nén khí Khải Nguyên Đồng Nai</strong> là cửa hàng và trung tâm kỹ thuật chuyên cung cấp 
              <strong> máy nén khí công nghiệp</strong>, <strong>phụ tùng máy nén khí trục vít chính hãng</strong>, 
              dịch vụ cho thuê và <strong>sửa chữa máy nén khí tại Đồng Nai</strong>. Kho hàng rộng lớn ngay tại Biên Hòa 
              cam kết giao hàng hỏa tốc trong 2 giờ đến các KCN Amata, Biên Hòa 1-2, Nhơn Trạch, Long Thành, Trảng Bom.
            </div>

            {/* Grid Thống Kê Nổi Bật */}
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 35px;">
              <div style="background-color: var(--bg-light); padding: 18px; border-radius: 8px; border: 1px solid #e2e8f0; text-align: center;">
                <div style="font-size: 28px; font-weight: 800; color: var(--primary-color);">2h Hỏa Tốc</div>
                <div style="font-size: 14px; color: var(--text-light);">Giao linh kiện tận nhà máy KCN</div>
              </div>
              <div style="background-color: var(--bg-light); padding: 18px; border-radius: 8px; border: 1px solid #e2e8f0; text-align: center;">
                <div style="font-size: 28px; font-weight: 800; color: var(--primary-color);">100% Chính Hãng</div>
                <div style="font-size: 14px; color: var(--text-light);">Dầu & phụ tùng Fusheng, Kobelco</div>
              </div>
              <div style="background-color: var(--bg-light); padding: 18px; border-radius: 8px; border: 1px solid #e2e8f0; text-align: center;">
                <div style="font-size: 28px; font-weight: 800; color: var(--primary-color);">24/7 Hỗ Trợ</div>
                <div style="font-size: 14px; color: var(--text-light);">Xử lý sự cố dừng máy khẩn cấp</div>
              </div>
            </div>

            {/* Dịch Vụ Cung Cấp */}
            <h2 style="font-size: 22px; color: var(--primary-color); margin-top: 40px; margin-bottom: 16px; font-weight: 700;">
              Các Dịch Vụ Máy Nén Khí Khải Nguyên Phục Vụ Tại Đồng Nai
            </h2>
            
            <div style="display: grid; gap: 20px; margin: 20px 0;">
              <div style="background-color: #fff; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0; box-shadow: 0 2px 5px rgba(0,0,0,0.04);">
                <h3 style="margin: 0 0 10px; font-size: 18px; color: var(--primary-color);">
                  1. Mua Bán Máy Nén Khí Công Nghiệp & Máy Nén Khí Cao Áp
                </h3>
                <p>
                  Khải Nguyên tư vấn lắp đặt hệ thống <a href="/san-pham" data-astro-prefetch="hover">máy nén khí công nghiệp</a> trục vít có dầu, 
                  không dầu (Oil-Free), và <a href="/san-pham/may-nen-khi-cao-ap" data-astro-prefetch="hover">máy nén khí cao áp 30-40 bar</a> cho các ngành 
                  thổi chai PET, cơ khí chính xác, dệt may, gỗ và bao bì tại Đồng Nai.
                </p>
              </div>

              <div style="background-color: #fff; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0; box-shadow: 0 2px 5px rgba(0,0,0,0.04);">
                <h3 style="margin: 0 0 10px; font-size: 18px; color: var(--primary-color);">
                  2. Cung Cấp Linh Kiện & Phụ Tùng Máy Nén Khí Trục Vít
                </h3>
                <p>
                  Kho linh kiện cung cấp đầy đủ <a href="/linh-kien-may-nen-khi-dong-nai" data-astro-prefetch="hover">linh kiện máy nén khí Đồng Nai</a>: 
                  Lọc tách dầu, lọc gió, lọc dầu, van cổ hút, van tiết lưu, cảm biến áp suất, dầu nhớt làm mát Fusheng, Hitachi, Kobelco, Atlas Copco.
                </p>
              </div>

              <div style="background-color: #fff; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0; box-shadow: 0 2px 5px rgba(0,0,0,0.04);">
                <h3 style="margin: 0 0 10px; font-size: 18px; color: var(--primary-color);">
                  3. Dịch Vụ Sửa Máy Công Nghiệp & Bảo Trì Máy Nén Khí Tận Nơi 24/7
                </h3>
                <p>
                  Đội ngũ kỹ sư túc trực tại Biên Hòa hỗ trợ <a href="/sua-may-cong-nghiep" data-astro-prefetch="hover">sửa máy công nghiệp</a> và 
                  <a href="/bao-tri-may-cong-nghiep" data-astro-prefetch="hover"> bảo trì máy công nghiệp</a> định kỳ, khắc phục sự cố nhiệt độ cao, 
                  keo dầu, kêu đầu nén, tụt áp cho tất cả xưởng sản xuất trong tỉnh Đồng Nai.
                </p>
              </div>
            </div>

            {/* Các KCN Phục Vụ Tại Đồng Nai */}
            <h2 style="font-size: 22px; color: var(--primary-color); margin-top: 40px; margin-bottom: 16px; font-weight: 700;">
              Danh Sách Các Khu Công Nghiệp Phục Vụ Hỏa Tốc Tại Đồng Nai
            </h2>
            <p>
              Khải Nguyên cam kết cử kỹ thuật viên có mặt tại xưởng hoặc giao hàng hỏa tốc chỉ trong vòng 2 giờ cho các Khu công nghiệp:
            </p>
            <ul style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 10px; padding-left: 20px;">
              <li><strong>KCN Amata</strong> (TP. Biên Hòa)</li>
              <li><strong>KCN Biên Hòa 1 & Biên Hòa 2</strong></li>
              <li><strong>KCN Nhơn Trạch 1, 2, 3, 5, 6</strong></li>
              <li><strong>KCN Long Thành & KCN Lộc An - Bình Sơn</strong></li>
              <li><strong>KCN Trảng Bom & KCN Hố Nai</strong></li>
              <li><strong>KCN Giang Điền & KCN Dầu Giây</strong></li>
            </ul>

            {/* Google Map Nhúng & Địa chỉ cửa hàng */}
            <h2 style="font-size: 22px; color: var(--primary-color); margin-top: 40px; margin-bottom: 16px; font-weight: 700;">
              Bản Đồ Vị Trí Cửa Hàng Máy Nén Khí Khải Nguyên Đồng Nai
            </h2>
            <div style="background-color: #f8fafc; padding: 20px; border-radius: 8px; border: 1px solid #cbd5e1; margin-bottom: 30px;">
              <p style="margin: 0 0 10px; font-weight: 600; font-size: 16px;">
                <strong>Địa chỉ cửa hàng & kho chính:</strong> 762a Tổ 25, Khu Phố 5, Phường Long Bình, TP. Biên Hòa, Tỉnh Đồng Nai
              </p>
              <p style="margin: 0 0 15px; font-weight: 600;">
                <strong>Hotline / Zalo tư vấn 24/7:</strong> <a href="tel:0909513637" style="color: var(--primary-color); font-size: 18px; font-weight: 800;">0909.513.637</a>
              </p>
              
              {/* Google Maps Iframe Embed */}
              <div style="width: 100%; height: 380px; border-radius: 8px; overflow: hidden; box-shadow: 0 3px 10px rgba(0,0,0,0.1);">
                <iframe
                  title="Vị trí Máy Nén Khí Khải Nguyên Đồng Nai trên Google Maps"
                  src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3917.4811989069357!2d106.883713!3d10.926839!2m3!1f0!0f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3174dfbc6c703db5%3A0x280eefb3cbfbb!2zNzYyYSBU4buVIDI1LCBLUCA1LCBMb25nIELDrG5oLCBUaMOgbmggcGjhu5EgQmnDqm4gSMOyYSwgxJDhu5NuZyBOYWksIFZpZXRuYW0!5e0!3m2!1svi!2s!4v1700000000000!5m2!1svi!2s"
                  width="100%"
                  height="100%"
                  style="border: 0;"
                  allowfullscreen
                  loading="lazy"
                  referrerPolicy="no-referrer-when-downgrade"
                ></iframe>
              </div>
              <div style="margin-top: 12px; text-align: right;">
                <a 
                  href="https://maps.app.goo.gl/zewZCeEwq8KnPSMk6" 
                  target="_blank" 
                  rel="noopener noreferrer"
                  style="color: var(--primary-color); font-weight: 600; font-size: 14px; text-decoration: underline;"
                >
                  Mở chỉ đường trực tiếp trên ứng dụng Google Maps
                </a>
              </div>
            </div>

          </article>
        </div>
      </section>

      <CTABanner client:visible />
    </div>
</Layout>
