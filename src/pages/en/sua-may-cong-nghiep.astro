---
import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb';
import CTABanner from '@/components/CTABanner';

const locale = 'en';
const title = '24/7 Industrial Machinery & Screw Air Compressor Repair Services';
const breadcrumbItems = [{ label: title }];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'name': 'Khai Nguyen 24/7 Industrial Machinery & Air Compressor Repair',
  'provider': {
    '@type': 'LocalBusiness',
    'name': 'Khai Nguyen Air Compressor'
  },
  'areaServed': ['Dong Nai', 'Bien Hoa', 'Binh Duong', 'Ho Chi Minh City'],
  'serviceType': 'Industrial Machinery & Screw Air Compressor Overhaul'
};
---

<Layout locale="en" title={title} description="Emergency 24/7 on-site repair and overhaul services for industrial machinery, screw air compressors, motors, and inverters across Southern Vietnam.">
  <div>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
    <Breadcrumb title={title} items={breadcrumbItems} locale="en" />

    <section class="section-padding">
      <div class="container" style="max-width: 960px; margin: 0 auto;">
        <article class="service-detail-content" style="font-size: 16px; line-height: 1.8; color: var(--text-color);">
          
          <div style="font-weight: 600; font-size: 17.5px; color: var(--text-dark); margin-bottom: 30px; padding: 20px 26px; background-color: #f0f7ff; border-left: 5px solid var(--primary-color); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; line-height: 1.65;">
            <strong>Khai Nguyen 24/7 Industrial Repair Services</strong> provides rapid emergency troubleshooting and full overhaul for 
            <strong>screw air compressors, industrial motors, VFD inverter drives, and factory pneumatic pipelines</strong> across Dong Nai, Binh Duong, and Ho Chi Minh City industrial parks.
          </div>

          <h2 style="font-size: 22px; color: var(--primary-color); margin-top: 35px; margin-bottom: 16px; font-weight: 700;">
            1. Core Emergency Repair Capabilities
          </h2>
          <ul style="padding-left: 20px; margin-bottom: 20px; display: flex; flex-direction: column; gap: 8px;">
            <li><strong>Screw Air-End Overhaul:</strong> Precision rotor gap alignment, bearing replacement, and dynamic vibration testing.</li>
            <li><strong>High-Temperature & Shutdown Troubleshooting:</strong> Resolving oil overheating, thermal valve jamming, and radiator scaling.</li>
            <li><strong>Motor Rewinding & Inverter Repair:</strong> High-efficiency motor bearing replacement and VFD frequency converter debugging.</li>
            <li><strong>2-Hour Rapid On-Site Response:</strong> Immediate deployment of diagnostic engineers to prevent factory production downtime.</li>
          </ul>

          <h2 style="font-size: 22px; color: var(--primary-color); margin-top: 35px; margin-bottom: 15px;">
            2. Request Emergency Support (24/7 Hotline)
          </h2>
          <div style="background-color: var(--bg-white); border: 2px solid var(--accent-color); border-radius: 8px; padding: 25px; margin-bottom: 30px;">
            <p style="margin-bottom: 8px;"><strong>Emergency Hotline:</strong> <a href="tel:0909513637" style="color: var(--accent-color); font-weight: 700;">0909 513 637</a></p>
            <p style="margin-bottom: 0;"><strong>Coverage:</strong> All Industrial Zones in Dong Nai, Binh Duong, Long An, and HCMC.</p>
          </div>
        </article>
      </div>
    </section>

    <CTABanner client:visible locale="en" />
  </div>
</Layout>
