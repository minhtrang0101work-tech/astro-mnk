---
import Layout from '@/layouts/Layout.astro';
import { ProductRepository } from '@/repositories/product.repository';
import { ProductService } from '@/services/product.service';
import Breadcrumb from '@/components/Breadcrumb';
import ProductGallery from '@/features/products/ProductGallery';
import ProductDescription from '@/features/products/ProductDescription';
import ProductCard from '@/features/products/ProductCard';
import CTABanner from '@/components/CTABanner';
import { getDictionary } from '@/lib/i18n';

export async function getStaticPaths() {
  const products = await ProductRepository.getAllProducts('en');
  return products.map(product => ({
    params: { category: product.category, slug: product.slug },
    props: { product }
  }));
}

const { category, slug } = Astro.params;
const { product } = Astro.props;

const locale = 'en';
const dict = await getDictionary(locale);

let relatedProducts = await ProductService.getRelatedProducts(product.id, product.category, 3, locale);
if (relatedProducts.length === 0) {
  const featured = await ProductService.getBestSellers(4, locale);
  relatedProducts = featured.filter(p => p.id !== product.id).slice(0, 3);
}

const baseUrl = 'https://maynenkhikhainguyen.com';
const absoluteImageUrl = product.image.startsWith('http') ? product.image : `${baseUrl}${product.image}`;
const cleanDescription = product.description ? product.description.replace(/<[^>]*>?/gm, '').trim() : '';
const finalDescription = cleanDescription || `Supplying high quality genuine ${product.title} with competitive pricing and 24/7 technical support at Khai Nguyen.`;

const productSchema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": product.title,
  "image": [absoluteImageUrl],
  "description": finalDescription,
  "sku": product.id,
  "mpn": (product.specs && product.specs['MPN Code'] !== 'Not updated') ? product.specs['MPN Code'] : undefined,
  "brand": {
    "@type": "Brand",
    "name": (product.specs && product.specs['Brand']) || "Khai Nguyen"
  },
  "offers": {
    "@type": "Offer",
    "url": `${baseUrl}/en/san-pham/${category}/${product.slug}`,
    "priceCurrency": "VND",
    "price": (product.price && product.price !== 'Contact for Quote') ? parseInt(product.price.replace(/[^0-9]/g, '') || "3000000", 10) : 3000000,
    "priceValidUntil": "2026-12-31",
    "availability": "https://schema.org/InStock",
    "itemCondition": "https://schema.org/NewCondition"
  }
};

const breadcrumbItems = [
  { label: dict.common.products, href: '/en/san-pham' },
  { label: product.categoryName, href: `/en/san-pham/${product.category}` },
  { label: product.title }
];
---

<Layout
  title={`${product.title} | Khai Nguyen Air Compressor Parts`}
  description={finalDescription.slice(0, 160)}
  canonical={`${baseUrl}/en/san-pham/${category}/${product.slug}`}
  image={absoluteImageUrl}
  schema={productSchema}
  locale={locale}
>
  <div class="product-detail-page-container">
    <Breadcrumb title={product.title} items={breadcrumbItems} locale={locale} />

    <section class="section-padding">
      <div class="container">
        <div class="detail-grid">
          <ProductGallery initialImage={product.image} client:load />

          <div class="detail-info">
            <span class="product-cat">
              {product.categoryName}
            </span>
            <h2 style="font-size: 26px; color: var(--text-dark); margin-bottom: 12px; font-weight: 700;">{product.title}</h2>
            
            <p style="color: var(--text-color); font-size: 15px; line-height: 1.6; margin-bottom: 20px;">
              {product.title} is an OEM-grade genuine replacement part distributed and supported on-site by Khai Nguyen across industrial parks in Dong Nai, Binh Duong, and Ho Chi Minh City.
            </p>

            <div class="detail-price-box">
              <div>
                <span class="price-label">List Price:</span>
                <span class="price-value">{product.price || 'Contact for Quote'}</span>
              </div>
            </div>

            <div class="detail-actions">
              <a href={`/en/lien-he?product=${encodeURIComponent(product.title)}`} class="btn btn-primary" style="padding: 15px 35px;" data-astro-prefetch="hover">
                <i class="fab fa-telegram-plane" style="margin-right: 8px;"></i> {dict.productDetail.quoteBtn}
              </a>
              <a href="tel:0909513637" class="btn btn-outline-dark" style="padding: 15px 35px;">
                <i class="fas fa-phone-alt" style="margin-right: 8px;"></i> 0909 513 637
              </a>
            </div>

            <ul class="detail-bullets">
              <li><i class="fas fa-certificate" style="color: #22c55e; font-size: 15px;"></i> 100% Genuine Quality Guarantee</li>
              <li><i class="fas fa-shield-alt" style="color: #22c55e; font-size: 15px;"></i> Official 6 - 24 months on-site warranty</li>
              <li><i class="fas fa-user-shield" style="color: #22c55e; font-size: 15px;"></i> Free on-site survey & engineering consultation</li>
            </ul>
          </div>
        </div>

        <div class="detail-grid detail-specs-section">
          <div>
            <ProductDescription description={product.description} specs={product.specs} locale={locale} />
          </div>

          <div class="detail-sidebar">
            <h3 class="sidebar-title">{dict.productDetail.whyTitle}</h3>
            <ul class="sidebar-reason-list">
              <li><i class="fas fa-check-circle"></i> Exact dimension & pressure engineering standards</li>
              <li><i class="fas fa-check-circle"></i> Over 15 years of screw compressor expertise</li>
              <li><i class="fas fa-check-circle"></i> Bien Hoa warehouse, 2-hour express delivery</li>
              <li><i class="fas fa-check-circle"></i> Competitive pricing optimizing operating costs</li>
            </ul>
          </div>
        </div>

        {relatedProducts.length > 0 && (
          <div style="margin-top: 60px; border-top: 1px solid var(--border-color); padding-top: 40px;">
            <h3 class="specs-title">{dict.productDetail.relatedTitle}</h3>
            <div class="products-grid">
              {relatedProducts.map((related) => (
                <ProductCard product={related} locale={locale} />
              ))}
            </div>
          </div>
        )}
      </div>
    </section>

    <CTABanner client:visible locale={locale} />
  </div>
</Layout>
