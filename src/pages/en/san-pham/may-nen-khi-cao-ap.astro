---
import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb';
import CTABanner from '@/components/CTABanner';

const locale = 'en';
const title = 'Industrial High-Pressure Air Compressors (20 Bar - 40 Bar)';
const breadcrumbItems = [
  { label: 'Products', href: '/en/san-pham' },
  { label: 'High-Pressure Compressors' }
];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  'name': 'Khai Nguyen 30-40 Bar Industrial High-Pressure Air Compressor System',
  'description': 'Dedicated 20-40 bar booster and high-pressure screw compressor systems for PET bottle blowing and heavy-duty CNC laser cutting.',
  'brand': {
    '@type': 'Brand',
    'name': 'Khai Nguyen'
  }
};
---

<Layout locale="en" title={title} description="Turnkey 20-40 Bar industrial high pressure screw and booster air compressor systems for PET bottle blow molding and CNC laser cutting in Southern Vietnam.">
  <div>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(productSchema)} />
    <Breadcrumb title={title} items={breadcrumbItems} locale="en" />

    <section class="section-padding">
      <div class="container" style="max-width: 960px; margin: 0 auto;">
        <article class="service-detail-content" style="font-size: 16px; line-height: 1.8; color: var(--text-color);">
          
          <div style="font-weight: 600; font-size: 17.5px; color: var(--text-dark); margin-bottom: 30px; padding: 20px 26px; background-color: #f0f7ff; border-left: 5px solid var(--primary-color); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; line-height: 1.65;">
            <strong>High-Pressure Air Compressors (20 Bar - 40 Bar)</strong> are specialized heavy-duty systems capable of delivering compressed air at pressures up to 40 kg/cm² (4.0 MPa). 
            They are critical components for <strong>PET bottle blow molding machinery, high-power CNC laser cutting lines, pressure testing vessels, and specialized pharmaceutical manufacturing.</strong>
          </div>

          <h2 style="font-size: 22px; color: var(--primary-color); margin-top: 35px; margin-bottom: 16px; font-weight: 700;">
            1. Key Industrial Applications of 30-40 Bar Compressors
          </h2>
          <ul style="padding-left: 20px; margin-bottom: 20px; display: flex; flex-direction: column; gap: 8px;">
            <li><strong>PET Bottle Blow Molding:</strong> Requires continuous 30 - 35 Bar high-pressure clean air to ensure crisp bottle molds and high production outputs.</li>
            <li><strong>High-Power CNC Fiber Laser Cutting:</strong> 16 - 30 Bar clean pressurized air replaces expensive liquid nitrogen, cutting metal cutting costs by up to 70%.</li>
            <li><strong>Hydrostatic & Pressure Vessel Testing:</strong> Testing structural integrity of tanks, high-pressure piping, and hydraulic cylinders.</li>
          </ul>

          <h2 style="font-size: 22px; color: var(--primary-color); margin-top: 35px; margin-bottom: 16px; font-weight: 700;">
            2. High-Pressure System Configurations
          </h2>
          <p>
            Khai Nguyen provides both integrated booster units (boosting 8 Bar to 40 Bar) and multi-stage reciprocating/screw high-pressure packages with specialized refrigerated dryers and 40 Bar certified air receiver tanks.
          </p>
        </article>
      </div>
    </section>

    <CTABanner client:visible locale="en" />
  </div>
</Layout>
