export async function getStaticPaths() {
  const zones = [
    'kcn-amata', 'kcn-bien-hoa-1', 'kcn-bien-hoa-2', 'kcn-nhon-trach', 'kcn-nhon-trach-1', 'kcn-nhon-trach-2',
    'kcn-vsip', 'kcn-vsip-1', 'kcn-vsip-2', 'kcn-song-than', 'kcn-giang-dien', 'kcn-long-thanh', 'kcn-my-phuoc',
    'kcn-phan-thiet', 'kcn-phu-my', 'kcn-dong-xuyen', 'kcn-trang-bang', 'kcn-phuoc-dong', 'kcn-thuan-dao',
    'bien-hoa', 'nhon-trach', 'trang-bom', 'long-thanh', 'di-an', 'thuan-an', 'thu-dau-mot', 'duc-hoa',
    'quan-12', 'binh-tan', 'dong-nai', 'binh-duong', 'ho-chi-minh', 'long-an', 'binh-thuan', 'ba-ria-vung-tau', 'tay-ninh'
  ];
  return zones.map(zone => ({ params: { zone } }));
}

const { zone } = Astro.params;
const locale = 'en';

  
  
  
  const dict = await getDictionary(locale);
  
  const info = zoneInfoMap[zone] || zoneInfoMap['kcn-amata'];

  const breadcrumbItems = [
    { label: dict.footer.repairLink, href: '/sua-chua-may-nen-khi' },
    { label: info.locationVi }
  ];

  const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": locale === 'vi' 
          ? `Thời gian kỹ thuật viên Khải Nguyên có mặt tại ${info.locationVi} khi máy nén khí gặp sự cố là bao lâu?` 
          : `How long does it take for Khai Nguyen technicians to arrive at ${info.locationEn} upon failure?`,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": locale === 'vi' 
            ? `Đối với các sự cố dừng máy khẩn cấp tại các nhà máy thuộc ${info.nameVi}, kỹ thuật của Khải Nguyên cam kết có mặt trực tiếp tại xưởng của bạn trong vòng từ 2 đến 4 giờ (riêng khu vực Biên Hòa, Đồng Nai có mặt trong vòng 2 giờ) để xử lý chẩn đoán.`
            : `For emergency compressor failures at factories in ${info.nameEn}, Khai Nguyen technicians commit to arriving on-site within 2 to 4 hours (within 2 hours for Bien Hoa, Dong Nai) to diagnose and troubleshoot.`
        }
      },
      {
        "@type": "Question",
        "name": locale === 'vi' 
          ? `Khải Nguyên có miễn phí khảo sát tại chỗ ở ${info.locationVi} không?`
          : `Does Khai Nguyen offer free on-site survey at ${info.locationEn}?`,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": locale === 'vi'
            ? `Có, chúng tôi hỗ trợ 100% chi phí đi lại, khảo sát và đo đạc kỹ thuật tận nơi tại nhà xưởng cho tất cả các doanh nghiệp nằm trong phạm vi ${info.nameVi}. Quý khách hàng không phải thanh toán bất kỳ chi phí kiểm tra ban đầu nào.`
            : `Yes, we support 100% of travel and technical survey costs directly at the plant for all businesses within ${info.nameEn}. Customers pay nothing for initial inspections.`
        }
      }
    ]
  };

  
