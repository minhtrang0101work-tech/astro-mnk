---
import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb';
import CTABanner from '@/components/CTABanner';

const locale = 'en';
const title = 'Dong Nai Air Compressor Parts Warehouse - 2-Hour Delivery';
const breadcrumbItems = [
  { label: 'Air Compressor Parts', href: '/en/linh-kien-may-nen-khi' },
  { label: 'Dong Nai' }
];

const productListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': 'Dong Nai Screw Air Compressor Spare Parts Hub',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Genuine Fusheng FS600 Compressor Oil',
      'url': 'https://maynenkhikhainguyen.com/en/san-pham/dau-may-va-phu-tung-boi-tron/dau-fusheng'
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'Screw Compressor Air-Oil Separator',
      'url': 'https://maynenkhikhainguyen.com/en/san-pham/bo-loc-va-tach-khi-nen/loc-tach-dau'
    },
    {
      '@type': 'ListItem',
      'position': 3,
      'name': 'Oil Filter & Air Intake Filter Elements',
      'url': 'https://maynenkhikhainguyen.com/en/san-pham/bo-loc-va-tach-khi-nen/loi-loc'
    }
  ]
};
---

<Layout locale="en" title={title} description="Authorized central warehouse for screw air compressor spare parts in Dong Nai. Genuine oil, filters, and valves with 2-hour express delivery.">
  <div>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(productListSchema)} />
    <Breadcrumb title={title} items={breadcrumbItems} locale="en" />

    <section class="section-padding">
      <div class="container" style="max-width: 960px; margin: 0 auto;">
        <article class="service-detail-content" style="font-size: 16px; line-height: 1.8; color: var(--text-color);">
          
          <div style="font-weight: 600; font-size: 17.5px; color: var(--text-dark); margin-bottom: 30px; padding: 20px 26px; background-color: #f0f7ff; border-left: 5px solid var(--primary-color); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; line-height: 1.65;">
            <strong>Khai Nguyen</strong> is the largest authorized <strong>air compressor spare parts warehouse in Dong Nai</strong>. 
            We distribute genuine wholesale and retail <strong>screw compressor replacement parts</strong> for Hitachi, Kobelco, Fusheng, Atlas Copco, and Ingersoll Rand with a guaranteed 2-hour on-site delivery commitment across all industrial parks.
          </div>

          <h2 style="font-size: 22px; color: var(--primary-color); margin-top: 35px; margin-bottom: 16px; font-weight: 700;">
            Comprehensive Spare Parts Inventory in Bien Hoa
          </h2>
          <p>
            For industrial compressed air systems, timely scheduled replacement of consumable parts (every 2,000h - 4,000h) is vital to preserve air-end longevity and prevent unexpected manufacturing downtime.
          </p>

          <h2 style="font-size: 22px; color: var(--primary-color); margin-top: 40px; margin-bottom: 16px; font-weight: 700;">
            Distributed Spare Parts Catalog
          </h2>
          
          <div style="overflow-x: auto; margin: 20px 0;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 15px;">
              <thead>
                <tr style="background-color: var(--primary-color); color: #fff;">
                  <th style="padding: 12px 15px; border: 1px solid #ddd;">Category</th>
                  <th style="padding: 12px 15px; border: 1px solid #ddd;">Compatible Brands & Models</th>
                  <th style="padding: 12px 15px; border: 1px solid #ddd;">Recommended Service Life</th>
                  <th style="padding: 12px 15px; border: 1px solid #ddd;">Dong Nai Delivery</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td style="padding: 12px 15px; border: 1px solid #ddd; font-weight: 600;">Air-Oil Separators</td>
                  <td style="padding: 12px 15px; border: 1px solid #ddd;">Fusheng, Kobelco, Hitachi, Mann Filter</td>
                  <td style="padding: 12px 15px; border: 1px solid #ddd;">3,000h - 4,000h operating hours</td>
                  <td style="padding: 12px 15px; border: 1px solid #ddd; color: green; font-weight: 600;">2-Hour Express</td>
                </tr>
                <tr style="background-color: #f8fafc;">
                  <td style="padding: 12px 15px; border: 1px solid #ddd; font-weight: 600;">Oil & Air Filters</td>
                  <td style="padding: 12px 15px; border: 1px solid #ddd;">Microfiber spin-on filters for screw compressors</td>
                  <td style="padding: 12px 15px; border: 1px solid #ddd;">2,000h - 3,000h operating hours</td>
                  <td style="padding: 12px 15px; border: 1px solid #ddd; color: green; font-weight: 600;">2-Hour Express</td>
                </tr>
                <tr>
                  <td style="padding: 12px 15px; border: 1px solid #ddd; font-weight: 600;">Compressor Lubricant</td>
                  <td style="padding: 12px 15px; border: 1px solid #ddd;">Fusheng FS600, Kobelco Extra Oil, Shell Corena S3/S4</td>
                  <td style="padding: 12px 15px; border: 1px solid #ddd;">3,000h - 4,000h operating hours</td>
                  <td style="padding: 12px 15px; border: 1px solid #ddd; color: green; font-weight: 600;">2-Hour Express</td>
                </tr>
              </tbody>
            </table>
          </div>

          <h2 style="font-size: 22px; color: var(--primary-color); margin-top: 35px; margin-bottom: 15px;">
            Order Spare Parts & Request Technical Quotation
          </h2>
          <div style="background-color: var(--bg-white); border: 2px solid var(--accent-color); border-radius: 8px; padding: 25px; margin-bottom: 30px;">
            <p style="margin-bottom: 8px;"><strong>Warehouse Address:</strong> 762a Hamlet 25, KP 5, Long Binh Ward, Bien Hoa, Dong Nai</p>
            <p style="margin-bottom: 8px;"><strong>Hotline / Zalo (24/7):</strong> <a href="tel:0909513637" style="color: var(--accent-color); font-weight: 700;">0909 513 637</a></p>
            <p style="margin-bottom: 0;"><strong>Support:</strong> Bilingual engineering team available for urgent parts consultation.</p>
          </div>
        </article>
      </div>
    </section>

    <CTABanner client:visible locale="en" />
  </div>
</Layout>
