---
import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb';
import CTABanner from '@/components/CTABanner';

const locale = 'zh';
const title = '24/7 工业机电设备与螺杆式空压机紧急抢修服务';
const breadcrumbItems = [{ label: title }];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'name': '凯源机械 24/7 工业机电设备与空压机紧急抢修',
  'provider': {
    '@type': 'LocalBusiness',
    'name': '凯源机械'
  },
  'areaServed': ['同奈省', '边和市', '平阳省', '胡志明市'],
  'serviceType': '工业机电设备与螺杆式空压机抢修大修'
};
---

<Layout locale="zh" title={title} description="越南同奈、平阳及南部工业区 24/7 工业机电设备、螺杆式空压机、工业电机与变频器紧急抢修大修服务。">
  <div>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
    <Breadcrumb title={title} items={breadcrumbItems} locale="zh" />

    <section class="section-padding">
      <div class="container" style="max-width: 960px; margin: 0 auto;">
        <article class="service-detail-content" style="font-size: 16px; line-height: 1.8; color: var(--text-color);">
          
          <div style="font-weight: 600; font-size: 17.5px; color: var(--text-dark); margin-bottom: 30px; padding: 20px 26px; background-color: #f0f7ff; border-left: 5px solid var(--primary-color); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; line-height: 1.65;">
            <strong>凯源机械 24/7 工业抢修技术中心</strong> 为同奈省、平阳省及胡志明市各工业区外资工厂提供 
            <strong>工业螺杆式空压机、三相异步电机、变频器与车间气动管网</strong> 快速故障诊断与大修服务。
          </div>

          <h2 style="font-size: 22px; color: var(--primary-color); margin-top: 35px; margin-bottom: 16px; font-weight: 700;">
            一、主要紧急抢修业务范围
          </h2>
          <ul style="padding-left: 20px; margin-bottom: 20px; display: flex; flex-direction: column; gap: 8px;">
            <li><strong>螺杆主机头大修:</strong> 阴阳螺杆转子精密间隙调校、进口重载轴承更换与动平衡校正。</li>
            <li><strong>高温跳机与油路结焦排查:</strong> 快速清洗疏通散热器、更换温控阀芯与抗磨机油。</li>
            <li><strong>电机与变频控制柜抢修:</strong> 电机绝缘耐压测试、轴承润滑与变频器参数优化。</li>
            <li><strong>2小时极速到达现场:</strong> 资深双语工程师团队随车携带专用检测设备与备用零件。</li>
          </ul>

          <h2 style="font-size: 22px; color: var(--primary-color); margin-top: 35px; margin-bottom: 15px;">
            二、24/7 紧急抢修联系方式
          </h2>
          <div style="background-color: var(--bg-white); border: 2px solid var(--accent-color); border-radius: 8px; padding: 25px; margin-bottom: 30px;">
            <p style="margin-bottom: 8px;"><strong>24/7 抢修热线:</strong> <a href="tel:0909513637" style="color: var(--accent-color); font-weight: 700;">0909 513 637</a></p>
            <p style="margin-bottom: 0;"><strong>覆盖区域:</strong> 同奈（边和、仁泽、龙城）、平阳（VSIP、神浪、美福）、隆安及胡志明市各工业区。</p>
          </div>
        </article>
      </div>
    </section>

    <CTABanner client:visible locale="zh" />
  </div>
</Layout>
