---
import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb';
import CTABanner from '@/components/CTABanner';

const locale = 'zh';
const title = '同奈省专业螺杆式空压机销售、租赁与24/7维修服务中心';
const breadcrumbItems = [{ label: title }];

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  'name': '凯源机械同奈空压机中心',
  'image': 'https://maynenkhikhainguyen.com/images/khobar-dongnai/kho-phu-tung-fusheng-dong-nai.jpg',
  '@id': 'https://maynenkhikhainguyen.com/zh/may-nen-khi-dong-nai',
  'url': 'https://maynenkhikhainguyen.com/zh/may-nen-khi-dong-nai',
  'telephone': '0909.513.637',
  'priceRange': '$$$',
  'address': {
    '@type': 'PostalAddress',
    'streetAddress': '762a Tổ 25, KP 5, Phường Long Bình',
    'addressLocality': 'Biên Hòa',
    'addressRegion': 'Đồng Nai',
    'postalCode': '810000',
    'addressCountry': 'VN'
  },
  'geo': {
    '@type': 'GeoCoordinates',
    'latitude': 10.926839,
    'longitude': 106.883713
  },
  'hasMap': 'https://maps.app.goo.gl/zewZCeEwq8KnPSMk6',
  'openingHoursSpecification': {
    '@type': 'OpeningHoursSpecification',
    'dayOfWeek': ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    'opens': '07:30',
    'closes': '19:00'
  }
};
---

<Layout locale="zh" title={title} description="同奈省边和市专业螺杆式空压机销售、应急租赁与24/7抢修维保中心。原装配件现货齐全，2小时极速送达各大工业园区。">
  <div>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(localBusinessSchema)} />
    <Breadcrumb title={title} items={breadcrumbItems} locale="zh" />

    <section class="section-padding">
      <div class="container" style="max-width: 960px; margin: 0 auto;">
        <article class="service-detail-content" style="font-size: 16px; line-height: 1.8; color: var(--text-color);">
          
          <div style="font-size: 13.5px; color: var(--text-light); margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
            <span>最后更新时间: 2026-08-14</span>
            <span style="margin: 0 8px; color: #ccc;">|</span>
            <span>核心实体仓库与服务基地: 越南同奈省边和市</span>
          </div>

          <div style="font-weight: 600; font-size: 17.5px; color: var(--text-dark); margin-bottom: 30px; padding: 20px 26px; background-color: #f0f7ff; border-left: 5px solid var(--primary-color); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; line-height: 1.65;">
            <strong>凯源机械（Khai Nguyen）同奈空压机服务中心</strong> 是同奈及南部重点工业区领先的 
            <strong>工业螺杆式空压机整机销售</strong>、<strong>原厂纯正配件直供</strong>、
            应急机组租赁以及 <strong>24/7 现场抢修维保服务商</strong>。我们在边和市设有大型现货仓库，承诺 2 小时内极速送达 Amata、边和 1-2、仁泽、龙城、壮奔等各大工业园区。
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 35px;">
            <div style="background-color: var(--bg-light); padding: 18px; border-radius: 8px; border: 1px solid #e2e8f0; text-align: center;">
              <div style="font-size: 28px; font-weight: 800; color: var(--primary-color);">2小时极速送达</div>
              <div style="font-size: 14px; color: var(--text-light);">工业区车间配件现货直发</div>
            </div>
            <div style="background-color: var(--bg-light); padding: 18px; border-radius: 8px; border: 1px solid #e2e8f0; text-align: center;">
              <div style="font-size: 28px; font-weight: 800; color: var(--primary-color);">100% 正品保障</div>
              <div style="font-size: 14px; color: var(--text-light);">复盛、神钢、日立等纯正油品与滤芯</div>
            </div>
            <div style="background-color: var(--bg-light); padding: 18px; border-radius: 8px; border: 1px solid #e2e8f0; text-align: center;">
              <div style="font-size: 28px; font-weight: 800; color: var(--primary-color);">24/7 应急抢修</div>
              <div style="font-size: 14px; color: var(--text-light);">专业中越双语工程师团队</div>
            </div>
          </div>

          <h2 style="font-size: 22px; color: var(--primary-color); font-weight: 700; margin-top: 35px; margin-bottom: 15px;">
            一、同奈省全方位工业空压机技术服务
          </h2>
          <p>
            凯源机械拥有 15 年以上南部外资工厂压缩空气系统实战经验，为您提供一站式专业保障：
          </p>
          <ul style="padding-left: 20px; margin-bottom: 20px; display: flex; flex-direction: column; gap: 8px;">
            <li><strong>整机销售与系统设计:</strong> 提供神钢（Kobelco）、日立（Hitachi）、阿特拉斯（Atlas Copco）、复盛（Fusheng）等 10HP - 200HP 螺杆式空压机。</li>
            <li><strong>定期预防性保养:</strong> 提供标准的 2000 小时与 4000 小时维保套餐，包含机油、机油滤清器、空气滤清器与油气分离芯更换。</li>
            <li><strong>螺杆主机大修:</strong> 转子精密间隙校准、进口轴承更换与动平衡测试。</li>
            <li><strong>应急空压机租赁:</strong> 提供多功率备用空压机租赁，彻底消除工厂停产断气风险。</li>
          </ul>

          <h2 style="font-size: 22px; color: var(--primary-color); font-weight: 700; margin-top: 35px; margin-bottom: 15px;">
            二、边和技术服务中心联系方式
          </h2>
          <div style="background-color: var(--bg-white); border: 2px solid var(--accent-color); border-radius: 8px; padding: 25px; margin-bottom: 30px;">
            <p style="margin-bottom: 8px;"><strong>总部地址:</strong> 越南同奈省边和市龙平坊25区762a</p>
            <p style="margin-bottom: 8px;"><strong>24/7 技术热线 / Zalo:</strong> <a href="tel:0909513637" style="color: var(--accent-color); font-weight: 700;">0909 513 637</a></p>
            <p style="margin-bottom: 0;"><strong>营业时间:</strong> 周一至周六 (07:30 - 19:00) | 24/7 紧急技术抢修值班</p>
          </div>
        </article>
      </div>
    </section>

    <CTABanner client:visible locale="zh" />
  </div>
</Layout>
