---
import Layout from '@/layouts/Layout.astro';
import { CategoryRepository } from '@/repositories/category.repository';
import { ProductService } from '@/services/product.service';
import Breadcrumb from '@/components/Breadcrumb';
import ProductGrid from '@/features/products/ProductGrid';
import ProductSidebar from '@/features/products/ProductSidebar';
import ProductSort from '@/features/products/ProductSort';
import CTABanner from '@/components/CTABanner';
import { getDictionary } from '@/lib/i18n';

const locale = 'zh';
const dict = await getDictionary(locale);

const categories = await CategoryRepository.getAllCategories();
const { products, total } = await ProductService.getProducts({}, locale);

const breadcrumbItems = [
  { label: dict.common.products }
];
---

<Layout
  title="原装螺杆式空压机配件与整机设备商城 | 凯源机械"
  description="专业批发与零售神钢、复盛、日立纯正螺杆机配件与机油，同奈及南部工业区2小时极速送达。"
  canonical="https://maynenkhikhainguyen.com/zh/san-pham"
  locale="zh"
>
  <Breadcrumb title={dict.products.title} items={breadcrumbItems} locale="zh" />

  <section class="section-padding">
    <div class="container product-page-layout">
      <ProductSidebar categories={categories} locale="zh" client:load />

      <div class="products-main">
        <div class="product-listing-header">
          <h2>{dict.common.allProducts} <span>({total} {dict.products.count})</span></h2>
          <ProductSort locale="zh" client:load />
        </div>

        <ProductGrid products={products} locale={locale} client:load />
              </div>
    </div>
  </section>

  <CTABanner client:visible locale="zh" />
</Layout>
