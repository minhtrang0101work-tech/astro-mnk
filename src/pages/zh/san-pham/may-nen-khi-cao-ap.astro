---
import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb';
import CTABanner from '@/components/CTABanner';

const locale = 'zh';
const title = '吹瓶与激光切割专用 20-40 Bar 高压螺杆式空压机系统';
const breadcrumbItems = [
  { label: '产品中心', href: '/zh/san-pham' },
  { label: '高压空压机' }
];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  'name': '凯源机械 30-40 Bar 工业级高压空压机与增压机系统',
  'description': '专为 PET 吹瓶成型、高功率 CNC 激光切割机设计的高压 20-40 Bar 空气压缩机系统与储气罐方案。',
  'brand': {
    '@type': 'Brand',
    'name': '凯源机械'
  }
};
---

<Layout locale="zh" title={title} description="越南专业 20-40 Bar 高压螺杆式空压机与增压机系统供应商。专用于 PET 吹瓶机、光纤激光切割与高压管道气密性测试。">
  <div>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(productSchema)} />
    <Breadcrumb title={title} items={breadcrumbItems} locale="zh" />

    <section class="section-padding">
      <div class="container" style="max-width: 960px; margin: 0 auto;">
        <article class="service-detail-content" style="font-size: 16px; line-height: 1.8; color: var(--text-color);">
          
          <div style="font-weight: 600; font-size: 17.5px; color: var(--text-dark); margin-bottom: 30px; padding: 20px 26px; background-color: #f0f7ff; border-left: 5px solid var(--primary-color); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; line-height: 1.65;">
            <strong>工业高压空压机（20 Bar - 40 Bar）</strong> 是能够稳定输出高达 40 kg/cm²（4.0 MPa）超高工作压力的专用压缩设备。
            广泛应用于 <strong>PET 塑料瓶吹瓶机、高功率光纤激光切割机辅助气体、压力容器水压/气密性测试以及高端制药包装生产线。</strong>
          </div>

          <h2 style="font-size: 22px; color: var(--primary-color); margin-top: 35px; margin-bottom: 16px; font-weight: 700;">
            一、30 - 40 Bar 高压空压机主要工业应用领域
          </h2>
          <ul style="padding-left: 20px; margin-bottom: 20px; display: flex; flex-direction: column; gap: 8px;">
            <li><strong>PET 塑料吹瓶成型行业:</strong> 需要持续稳定提供 30 - 35 Bar 无水无油洁净高压气源，确保瓶身成型透亮无瑕疵。</li>
            <li><strong>高功率光纤激光切割机:</strong> 采用 16 - 30 Bar 高压洁净空气替代昂贵的高纯液氮作为辅助切割气体，帮助加工厂降低高达 70% 气体成本。</li>
            <li><strong>管道气密性与高压耐压检测:</strong> 用于各类化工管道、阀门及压力容器的保压检漏。</li>
          </ul>

          <h2 style="font-size: 22px; color: var(--primary-color); margin-top: 35px; margin-bottom: 16px; font-weight: 700;">
            二、高压系统一站式选型配置
          </h2>
          <p>
            凯源机械提供从 8 Bar 增压至 40 Bar 的增压机（Booster）方案，以及多级压缩高压整机机组，配套 40 Bar 高压专用冷干机与特种高压储气罐。
          </p>
        </article>
      </div>
    </section>

    <CTABanner client:visible locale="zh" />
  </div>
</Layout>
