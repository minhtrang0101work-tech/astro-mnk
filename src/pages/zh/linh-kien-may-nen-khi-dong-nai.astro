---
import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '@/components/Breadcrumb';
import CTABanner from '@/components/CTABanner';

const locale = 'zh';
const title = '同奈省空压机原装配件大型现货仓库 - 工业区2小时极速送达';
const breadcrumbItems = [
  { label: '空压机原装配件', href: '/zh/linh-kien-may-nen-khi' },
  { label: '同奈省' }
];

const productListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': '同奈省专业螺杆式空压机原厂配件集散中心',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': '复盛 (Fusheng) FS600 纯正原装合成空压机专用油',
      'url': 'https://maynenkhikhainguyen.com/zh/san-pham/dau-may-va-phu-tung-boi-tron/dau-fusheng'
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': '螺杆式空压机高效油气分离芯 (油分芯)',
      'url': 'https://maynenkhikhainguyen.com/zh/san-pham/bo-loc-va-tach-khi-nen/loc-tach-dau'
    },
    {
      '@type': 'ListItem',
      'position': 3,
      'name': '纯正机油滤芯与高精度空气滤清器',
      'url': 'https://maynenkhikhainguyen.com/zh/san-pham/bo-loc-va-tach-khi-nen/loi-loc'
    }
  ]
};
---

<Layout locale="zh" title={title} description="同奈省边和市大型螺杆空压机原厂配件直销中心。神钢、复盛、日立纯正机油、油分芯、滤清器现货齐全，2小时极速送达。">
  <div>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(productListSchema)} />
    <Breadcrumb title={title} items={breadcrumbItems} locale="zh" />

    <section class="section-padding">
      <div class="container" style="max-width: 960px; margin: 0 auto;">
        <article class="service-detail-content" style="font-size: 16px; line-height: 1.8; color: var(--text-color);">
          
          <div style="font-weight: 600; font-size: 17.5px; color: var(--text-dark); margin-bottom: 30px; padding: 20px 26px; background-color: #f0f7ff; border-left: 5px solid var(--primary-color); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; line-height: 1.65;">
            <strong>凯源机械（Khai Nguyen）</strong> 是同奈省边和市规模领先的 <strong>工业螺杆式空压机配件分销中心</strong>。
            我们专业批发与零售日立（Hitachi）、神钢（Kobelco）、复盛（Fusheng）、阿特拉斯（Atlas Copco）、英格索兰（Ingersoll Rand）等主流品牌纯正原厂配件，承诺同奈省各大工业区 2 小时现货极速送达。
          </div>

          <h2 style="font-size: 22px; color: var(--primary-color); margin-top: 35px; margin-bottom: 16px; font-weight: 700;">
            边和大型实体仓库 - 现货充足
          </h2>
          <p>
            工业空压机系统按期（2000小时 - 4000小时）更换消耗性维保零配件，是确保主机寿命与电机节能的关键。
          </p>

          <h2 style="font-size: 22px; color: var(--primary-color); margin-top: 40px; margin-bottom: 16px; font-weight: 700;">
            常用螺杆空压机配件供应清单
          </h2>
          
          <div style="overflow-x: auto; margin: 20px 0;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 15px;">
              <thead>
                <tr style="background-color: var(--primary-color); color: #fff;">
                  <th style="padding: 12px 15px; border: 1px solid #ddd;">配件大类</th>
                  <th style="padding: 12px 15px; border: 1px solid #ddd;">适配品牌与规格</th>
                  <th style="padding: 12px 15px; border: 1px solid #ddd;">推荐更换周期</th>
                  <th style="padding: 12px 15px; border: 1px solid #ddd;">同奈配送时效</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td style="padding: 12px 15px; border: 1px solid #ddd; font-weight: 600;">油气分离芯 (油分芯)</td>
                  <td style="padding: 12px 15px; border: 1px solid #ddd;">复盛、神钢、日立、曼牌 (Mann Filter)</td>
                  <td style="padding: 12px 15px; border: 1px solid #ddd;">3000 - 4000 运行小时</td>
                  <td style="padding: 12px 15px; border: 1px solid #ddd; color: green; font-weight: 600;">2小时极速送达</td>
                </tr>
                <tr style="background-color: #f8fafc;">
                  <td style="padding: 12px 15px; border: 1px solid #ddd; font-weight: 600;">机油与空气滤清器</td>
                  <td style="padding: 12px 15px; border: 1px solid #ddd;">微纳米褶皱滤纸旋装滤芯</td>
                  <td style="padding: 12px 15px; border: 1px solid #ddd;">2000 - 3000 运行小时</td>
                  <td style="padding: 12px 15px; border: 1px solid #ddd; color: green; font-weight: 600;">2小时极速送达</td>
                </tr>
                <tr>
                  <td style="padding: 12px 15px; border: 1px solid #ddd; font-weight: 600;">空压机专用机油</td>
                  <td style="padding: 12px 15px; border: 1px solid #ddd;">复盛 FS600, 神钢原厂油, 壳牌确能力 S3/S4</td>
                  <td style="padding: 12px 15px; border: 1px solid #ddd;">3000 - 4000 运行小时</td>
                  <td style="padding: 12px 15px; border: 1px solid #ddd; color: green; font-weight: 600;">2小时极速送达</td>
                </tr>
              </tbody>
            </table>
          </div>

          <h2 style="font-size: 22px; color: var(--primary-color); margin-top: 35px; margin-bottom: 15px;">
            配件采购与技术支持热线
          </h2>
          <div style="background-color: var(--bg-white); border: 2px solid var(--accent-color); border-radius: 8px; padding: 25px; margin-bottom: 30px;">
            <p style="margin-bottom: 8px;"><strong>仓库地址:</strong> 越南同奈省边和市龙平坊25区762a</p>
            <p style="margin-bottom: 8px;"><strong>24/7 现货咨询热线:</strong> <a href="tel:0909513637" style="color: var(--accent-color); font-weight: 700;">0909 513 637</a></p>
            <p style="margin-bottom: 0;"><strong>服务支持:</strong> 中越双语专业工程团队提供免费配件选型咨询。</p>
          </div>
        </article>
      </div>
    </section>

    <CTABanner client:visible locale="zh" />
  </div>
</Layout>
