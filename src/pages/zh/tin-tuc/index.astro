---
import Layout from '@/layouts/Layout.astro';
import { NewsService } from '@/services/news.service';
import Breadcrumb from '@/components/Breadcrumb';
import NewsCard from '@/features/news/NewsCard';
import NewsletterForm from '@/components/NewsletterForm';
import CTABanner from '@/components/CTABanner';
import { getDictionary } from '@/lib/i18n';

const locale = 'zh';
const dict = await getDictionary(locale);

const { news: articles } = await NewsService.getNews({}, locale);

const breadcrumbItems = [
  { label: dict.common.news }
];
---

<Layout
  title="工业空压机技术动态与节能指南 | 凯源机械"
  description="实时获取工业螺杆空压机保养指南、故障排查与节能降耗前沿技术。"
  canonical="https://maynenkhikhainguyen.com/zh/tin-tuc"
  locale="zh"
>
  <Breadcrumb title={dict.news.title} items={breadcrumbItems} locale="zh" />

  <section class="section-padding">
    <div class="container blog-layout">
      <div class="blog-main">
        <div class="blog-grid">
          {articles.map((article) => (
            <NewsCard news={article} locale="zh" />
          ))}
        </div>
      </div>

      <aside class="blog-sidebar">
        <div class="sidebar-widget">
          <h3>订阅工业技术资讯</h3>
          <div class="widget-newsletter" style="margin-top: 15px;">
            <NewsletterForm dict={dict.footer} client:visible />
          </div>
        </div>
      </aside>
    </div>
  </section>

  <CTABanner client:visible locale="zh" />
</Layout>
