# ==========================================
# CẤU HÌNH HEADLESS WORDPRESS CMS
# ==========================================

# 1. Chọn nguồn dữ liệu: 'WORDPRESS' (kết nối trực tiếp CMS) hoặc 'MOCK' (dữ liệu mẫu)
CMS_PROVIDER=WORDPRESS

# 2. Đường dẫn WordPress REST API (bắt buộc /wp-json/wp/v2)
WORDPRESS_API_URL=https://your-wordpress-domain.com/wp-json/wp/v2

# 3. Google Sheets Webhook lưu thông tin Form liên hệ
GOOGLE_SHEET_API_URL=https://script.google.com/macros/s/AKfycb.../exec

# 4. Domain website chính thức
SITE_URL=https://maynenkhikhainguyen.com
